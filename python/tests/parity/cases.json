  {
    "name": "text-validations",
    "spec": {
      "type": "panel",
      "id": "panel",
      "name": "Profile",
      "children": [
        {
          "type": "input",
          "id": "text",
          "name": "Name",
          "dataType": "string",
          "configs": {
            "key": "name"
          },
          "validations": [
            {
              "validator": "required"
            },
            {
              "validator": "minLength",
              "value": 3
            },
            {
              "validator": "maxLength",
              "value": 8,
              "message": "Trop long"
            },
            {
              "validator": "pattern",
              "value": "^[A-Z]"
            }
          ]
        },
        {
          "type": "input",
          "id": "text",
          "name": "Code",
          "dataType": "string",
          "configs": {
            "key": "code"
          },
          "validations": [
            {
              "validator": "pattern",
              "value": "^(?<area>[A-Z]{2})-\\d+$",
              "message": {
                "fr": "Code AA-123 attendu",
                "en": "Expected code AA-123"
              }
            },
            {
              "validator": "minLength",
              "value": 4
            }
          ]
        },
        {
          "type": "input",
          "id": "email",
          "name": "Email",
          "dataType": "string",
          "configs": {
            "key": "email"
          },
          "validations": [
            {
              "validator": "email"
            }
          ]
        },
        {
          "type": "input",
          "id": "url",
          "name": "Site",
          "dataType": "string",
          "configs": {
            "key": "site"
          },
          "validations": [
            {
              "validator": "url"
            }
          ]
        },
        {
          "type": "input",
          "id": "text",
          "name": "Emoji",
          "dataType": "string",
          "configs": {
            "key": "emoji"
          },
          "validations": [
            {
              "validator": "maxLength",
              "value": 2
            }
          ]
        },
        {
          "type": "input",
          "id": "text",
          "name": "Nickname",
          "dataType": [
            "string",
            "null"
          ],
          "configs": {
            "key": "nickname"
          },
          "validations": [
            {
              "validator": "minLength",
              "value": 2
            }
          ]
        },
        {
          "type": "input",
          "id": "text",
          "name": "Localized empty",
          "dataType": "string",
          "configs": {
            "key": "le"
          },
          "validations": [
            {
              "validator": "minLength",
              "value": 2,
              "message": {
                "fr": "",
                "en": "Too short"
              }
            }
          ]
        }
      ]
