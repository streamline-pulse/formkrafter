[
  {
    "name": "customs-declaration",
    "spec": {
      "type": "panel",
      "id": "panel",
      "name": "Declaration",
      "children": [
        {
          "type": "panel",
          "id": "row",
          "name": "Row",
          "children": [
            {
              "type": "input",
              "id": "date",
              "name": "Effective date",
              "dataType": "string",
              "configs": {
                "key": "effective_date"
              },
              "validations": [
                {
                  "validator": "required"
                }
              ]
            },
            {
              "type": "input",
              "id": "select",
              "name": "Origin",
              "dataType": "string",
              "configs": {
                "key": "origin",
                "options": [
                  {
                    "value": "CI",
                    "label": "Côte d'Ivoire"
                  }
                ]
              },
              "validations": [
                {
                  "validator": "required",
                  "message": {
                    "fr": "Choisissez l'origine",
                    "en": "Pick the origin"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "collection",
          "id": "data-grid",
          "name": "Items",
          "dataType": "array",
          "configs": {
            "key": "items"
          },
          "validations": [
            {
              "validator": "minItems",
              "value": 1
            },
            {
              "validator": "maxItems",
              "value": "3"
            }
          ],
          "children": [
            {
              "type": "input",
              "id": "text",
              "name": "HS code",
              "dataType": "string",
              "configs": {
                "key": "hs_code"
              },
              "validations": [
                {
                  "validator": "required"
                },
                {
                  "validator": "pattern",
                  "value": "^\\d{4}(\\.\\d{2}){0,3}$"
                }
              ]
            },
            {
              "type": "input",
              "id": "number",
              "name": "Declared value",
              "dataType": "number",
              "configs": {
                "key": "declared_value"
              },
              "validations": [
                {
                  "validator": "required"
                },
                {
                  "validator": "min",
                  "value": 0
                }
              ]
            },
            {
              "type": "input",
              "id": "number",
              "name": "Weight",
              "dataType": "number",
              "configs": {
                "key": "gross_weight_kg"
              },
              "validations": [
                {
                  "validator": "min",
                  "value": 0.5
                },
                {
                  "validator": "max",
                  "value": 100000
                }
              ]
            }
          ]
        },
        {
          "type": "input",
          "id": "number",
          "name": "Containers",
          "dataType": "integer",
          "configs": {
            "key": "containers"
          },
          "validations": [
            {
              "validator": "min",
              "value": 0
            },
            {
              "validator": "max",
              "value": 99
            }
          ]
        },
        {
          "type": "input",
          "id": "number",
          "name": "Freight",
          "dataType": "number",
          "configs": {
            "key": "freight"
          },
          "validations": [
            {
              "validator": "min",
              "value": "0"
            }
          ]
        },
        {
          "type": "output",
          "id": "content",
          "name": "Help",
          "dataType": "void",
          "configs": {
            "key": "help",
            "content": "Fill in the declaration"
          }
        }
      ]
    },
    "locales": [
      "fr",
      "en",
