{
  "name": "@streamline-pulse/formkrafter-core",
  "version": "0.18.0",
  "description": "Framework-agnostic core for FormKrafter: form specs, RFC 6902 ops with undo/redo, Ajv validation, sandboxed rules engine and injectable services",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "form-builder",
    "formio",
    "forms",
    "json-schema",
    "low-code"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build lib/index.ts --outdir dist --format esm --external acorn --external json-logic-js --external fast-json-patch --sourcemap=linked && tsc -p . --emitDeclarationOnly",
    "prepublishOnly": "cp ../../LICENSE . && bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "acorn": "catalog:",
    "fast-json-patch": "catalog:",
    "json-logic-js": "catalog:"
  },
  "devDependencies": {
    "@types/json-logic-js": "catalog:",
    "ajv": "catalog:",
    "ajv-errors": "catalog:",
    "ajv-formats": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamline-pulse/formkrafter.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/streamline-pulse/formkrafter/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/streamline-pulse/formkrafter/issues"
  }
}
