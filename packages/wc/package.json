{
  "name": "@streamline-pulse/formkrafter-wc",
  "version": "0.2.0",
  "description": "FormKrafter web components (Stencil)",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/formkrafter-wc/formkrafter-wc.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./styles.css": "./dist/formkrafter-wc/formkrafter-wc.css",
    "./dist/components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./dist/components/*.js": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js",
      "types": "./loader/index.d.ts"
    }
  },
  "license": "MIT",
  "keywords": [
    "form",
    "form-builder",
    "drag-and-drop",
    "web-components",
    "stencil",
    "formkrafter"
  ],
  "files": [
    "dist/",
    "loader/",
    "LICENSE"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "generate": "stencil generate",
    "prepublishOnly": "cp ../../LICENSE . && bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@streamline-pulse/formkrafter-core": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.43.5",
    "@stencil/react-output-target": "^1.6.1",
    "@stencil/vue-output-target": "^0.14.1",
    "@types/node": "catalog:",
    "happy-dom": "^20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamline-pulse/formkrafter.git",
    "directory": "packages/wc"
  },
  "homepage": "https://github.com/streamline-pulse/formkrafter/tree/main/packages/wc#readme",
  "bugs": {
    "url": "https://github.com/streamline-pulse/formkrafter/issues"
  }
}
