{
  "name": "@streamline-pulse/formkrafter-wc",
  "version": "0.0.1",
  "description": "FormKrafter web components (Stencil)",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/formkrafter-wc/formkrafter-wc.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/formkrafter-wc/formkrafter-wc.esm.js",
      "require": "./dist/formkrafter-wc/formkrafter-wc.cjs.js"
    },
    "./styles.css": "./dist/formkrafter-wc/formkrafter-wc.css",
    "./dist/components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./dist/components/*.js": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@streamline-pulse/formkrafter-core": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.43.5",
    "@stencil/react-output-target": "^1.6.1",
    "@stencil/vue-output-target": "^0.14.1",
    "@types/node": "catalog:"
  }
}
