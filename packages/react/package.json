{
  "name": "@streamline-pulse/formkrafter-react",
  "version": "0.10.0",
  "description": "React bindings for FormKrafter web components",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "form-builder",
    "formio",
    "forms",
    "low-code",
    "react",
    "web-components"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "cp ../../LICENSE . && bun run build"
  },
  "dependencies": {
    "@stencil/react-output-target": "^1.6.1",
    "@streamline-pulse/formkrafter-wc": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamline-pulse/formkrafter.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/streamline-pulse/formkrafter/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/streamline-pulse/formkrafter/issues"
  }
}
