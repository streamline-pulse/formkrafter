{
  "name": "@streamline-pulse/formkrafter-vue",
  "version": "0.16.0",
  "description": "Vue bindings for FormKrafter web components",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "form-builder",
    "formio",
    "forms",
    "low-code",
    "vue",
    "web-components"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "cp ../../LICENSE . && bun run build"
  },
  "dependencies": {
    "@stencil/vue-output-target": "^0.14.1",
    "@streamline-pulse/formkrafter-wc": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamline-pulse/formkrafter.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/streamline-pulse/formkrafter/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/streamline-pulse/formkrafter/issues"
  }
}
