{
  "name": "formkrafter",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "e2e",
      "docs"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "acorn": "^8.17.0",
      "ajv": "^8.20.0",
      "ajv-errors": "^3.0.0",
      "awilix": "^13.0.5",
      "uuid": "^14.0.1",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "@types/react": "^19.2.17",
      "vue": "^3.5.40",
      "json-logic-js": "^2.0.5",
      "@types/json-logic-js": "^2.0.8",
      "fast-json-patch": "^3.1.1",
      "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
      "@types/node": "^26.1.1",
      "ajv-formats": "^3.0.1"
    }
  },
  "scripts": {
    "build": "bun run --filter '@streamline-pulse/*' build",
    "test": "bun run --filter '@streamline-pulse/*' test",
    "smoke:esm": "node scripts/smoke-esm.mjs",
    "lint": "eslint .",
    "e2e": "bun run --cwd examples/tanstack-start build && bun run --cwd examples/vue build && bun run --cwd e2e test",
    "e2e:only": "bun run --cwd e2e test",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version-packages": "changeset version && rm -f bun.lock && bun install",
    "release": "bun run build && bun scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0"
  }
}
