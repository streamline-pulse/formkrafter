{
  "name": "formkrafter",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "acorn": "^8.17.0",
      "ajv": "^8.20.0",
      "ajv-errors": "^3.0.0",
      "awilix": "^13.0.5",
      "uuid": "^14.0.1",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "@types/react": "^19.2.17",
      "vue": "^3.5.40",
      "json-logic-js": "^2.0.5",
      "@types/json-logic-js": "^2.0.8",
      "fast-json-patch": "^3.1.1",
      "@atlaskit/pragmatic-drag-and-drop": "^2.0.1"
    }
  },
  "scripts": {
    "build": "bun run --filter '@streamline-pulse/*' build",
    "test": "bun run --filter '@streamline-pulse/*' test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0"
  }
}
