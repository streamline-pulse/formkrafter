</style>

<script>
  const toggle = document.getElementById('fkThemeToggle')
  toggle?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark'
    const next = current === 'light' ? 'dark' : 'light'
    document.documentElement.dataset.theme = next
    try {
      localStorage.setItem('starlight-theme', next)
    } catch {
      /* storage unavailable */
    }
  })

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  const stage = document.querySelector('.fk-builder') as HTMLElement | null
  const canvasBody = document.getElementById('fkCanvasBody')
  const dropHint = document.getElementById('fkDropHint')
  const ghost = document.getElementById('fkGhost')
  const chips = Array.from(document.querySelectorAll<HTMLElement>('.fk-chip'))

  const FIELDS = [
    { chip: 'Text', label: 'Full name', kind: 'text' },
    { chip: 'Email', label: 'Email', kind: 'email' },
    { chip: 'Select', label: 'Role', kind: 'select' },
    { chip: 'Checkbox', label: 'Terms', kind: 'checkbox' },
  ] as const

  function fieldHTML(f: (typeof FIELDS)[number]): string {
    if (f.kind === 'checkbox') {
      return `<div class="fk-field fk-field--inline"><div class="fk-input"></div><label>${f.label}</label></div>`
    }
    return `<div class="fk-field"><label>${f.label}</label><div class="fk-input"></div></div>`
  }

  if (stage && canvasBody && dropHint && ghost && chips.length) {
    let i = 0

    function reset() {
      canvasBody!.innerHTML = ''
      dropHint!.classList.remove('is-hidden')
      for (const c of chips) c.classList.remove('is-active')
      i = 0
    }

    function placeNext() {
      const idx = i % FIELDS.length
      const field = FIELDS[idx]
      const chipEl = chips[idx]
      chipEl.classList.add('is-active')

      if (reduce) {
        canvasBody!.insertAdjacentHTML('beforeend', fieldHTML(field))
        dropHint!.classList.add('is-hidden')
        i++
        return
      }

      const stageRect = stage!.getBoundingClientRect()
      const chipRect = chipEl.getBoundingClientRect()
      const canvasRect = canvasBody!.getBoundingClientRect()

      ghost!.textContent = field.chip
      ghost!.style.transform = `translate(${chipRect.left - stageRect.left}px, ${chipRect.top - stageRect.top}px)`
      ghost!.style.opacity = '1'

      const targetX = canvasRect.left - stageRect.left + 8
      const targetY = canvasRect.top - stageRect.top + canvasRect.height / 2 - 12

      ghost!.animate(
        [
          { transform: ghost!.style.transform, opacity: 1 },
          {
            transform: `translate(${targetX}px, ${targetY}px)`,
            opacity: 0,
          },
        ],
        { duration: 550, easing: 'cubic-bezier(.4,0,.2,1)' }
      )

      setTimeout(() => {
        dropHint!.classList.add('is-hidden')
        canvasBody!.insertAdjacentHTML('beforeend', fieldHTML(field))
        ghost!.style.opacity = '0'
        i++
      }, 480)
    }

    if (reduce) {
      for (let n = 0; n < FIELDS.length; n++) placeNext()
    } else {
      function loop() {
        setTimeout(() => {
          if (i > 0 && i % FIELDS.length === 0) {
            reset()
            setTimeout(loop, 500)
          } else {
            placeNext()
            loop()
          }
        }, 1500)
      }
      placeNext()
      loop()
    }
  }
</script>
