---
interface Props {
  lang?: 'en' | 'fr'
}

const { lang = 'en' } = Astro.props

const baseRoot = import.meta.env.BASE_URL.replace(/\/$/, '') + '/'
const base = lang === 'fr' ? `${baseRoot}fr/` : baseRoot
const altHref = lang === 'fr' ? baseRoot : `${baseRoot}fr/`
const github = 'https://github.com/streamline-pulse/formkrafter'

const t =
  lang === 'fr'
    ? {
        navDocs: 'Docs',
        navDemo: 'Démo',
        navStart: 'Commencer',
        pill: 'MIT · Web Components · React · Vue · React Native',
        h1a: 'Construisez vos formulaires',
        h1b: 'une fois, exécutez-les partout',
        lede: "Un builder de formulaires drag & drop et son renderer, utilisables en HTML pur, React, Vue ou React Native — avec validation, règles dynamiques, formulaires imbriqués et i18n intégrés.",
        ctaStart: 'Commencer →',
        ctaDemo: 'Voir la démo live',
        install: 'bun add @streamline-pulse/formkrafter-react',
        howEyebrow: 'Comment ça marche',
        howTitle: 'Un spec JSON. Trois étapes. Zéro divergence.',
        steps: [
          {
            n: '01',
            title: 'Décrire',
            text: "Chaque formulaire est un arbre JSON de bricks — champs, panels, validations, règles. Exportable, diffable, stockable où vous voulez.",
            code: `{ id: 'email', validations: [required] }`,
          },
          {
            n: '02',
            title: 'Valider',
            text: 'Le même spec compile un schéma Ajv — côté client en temps réel, côté serveur avec exactement le même verdict.',
            code: `validateFormData(spec, data, 'fr')`,
          },
          {
            n: '03',
            title: 'Afficher',
            text: 'Un seul spec, quatre renderers : Web Components nus, React, Vue ou React Native — au choix par app, une seule source de vérité.',
            code: `<FkFormRender spec={spec} />`,
          },
        ],
        fwEyebrow: 'Intégrations',
        fwTitle: 'Un comportement, trois façons de le brancher.',
        frameworks: [
          {
            name: 'Web Components',
            text: 'Custom elements purs (Stencil). Aucune dépendance de framework.',
            install: 'bun add @streamline-pulse/formkrafter-wc',
          },
          {
            name: 'React',
            text: 'Wrappers fins générés depuis les web components — props et événements typés.',
            install: 'bun add @streamline-pulse/formkrafter-react',
          },
          {
            name: 'Vue 3',
            text: 'Même surface, composants Vue natifs.',
            install: 'bun add @streamline-pulse/formkrafter-vue',
          },
        ],
        whyEyebrow: 'Atouts',
        whyTitle: 'Pourquoi FormKrafter.',
        features: [
          {
            icon: '🧩',
            title: 'Agnostique du framework',
            text: 'Web Components à la base ; wrappers React et Vue générés depuis la même source.',
          },
          {
            icon: '⚡',
            title: 'Léger, vraiment',
            text: '~130 Ko gzippés pour une page qui fait tourner le builder complet. Éditeur de code en lazy, zéro framework CSS.',
          },
          {
            icon: '🛡️',
            title: 'Règles sans eval',
            text: 'JSON Logic ou JS sandboxé par un interpréteur AST : compatible CSP, budget d’exécution.',
          },
          {
            icon: '📄',
            title: 'Des specs, pas des composants',
            text: 'Formulaires en JSON portable. Patches RFC 6902 bidirectionnels, undo/redo intégré.',
          },
          {
            icon: '🔁',
            title: 'Convertisseur Form.io',
            text: 'convertFormioForm migre champs, wizards, validations et uploads — et signale le reste.',
          },
          {
            icon: '🌍',
            title: 'i18n de bout en bout',
            text: 'Contenu et chrome du builder localisés ; anglais et français fournis, extensible.',
          },
        ],
        codeEyebrow: 'En pratique',
        codeTitle: 'Un builder, un renderer, un événement.',
        codeFile: 'App.tsx',
        migEyebrow: 'Migration',
        migTitle: 'Vous venez de Form.io ?',
        migText: 'Divisez par ~3,5 le poids gzippé de votre stack, abandonnez Bootstrap, et voyez vos définitions stockées fondre de 3 à 5,5× sur des exports de production réels.',
        migCta: 'Guide de migration',
        migFig1: '470 Ko → 130 Ko',
        migFig2: 'specs ÷ 3–5,5',
        usesEyebrow: 'Cas d’usage',
        usesTitle: 'Là où ça sert, vraiment.',
        uses: [
          {
            title: 'Outils internes & back-office',
            text: "Gestion de dossiers, approbations, consoles d'admin — les formulaires que votre équipe ops touche chaque jour.",
          },
          {
            title: 'Services citoyens',
            text: 'Formulaires publics multilingues, documents officiels, règles d’éligibilité conditionnelles.',
          },
          {
            title: 'Onboarding & enquêtes',
            text: 'KYC, onboarding produit, feedback — des wizards avec validation par étape.',
          },
          {
            title: 'Builder embarqué',
            text: 'Donnez à vos propres clients un builder de formulaires — palette en marque blanche, votre modèle de données.',
          },
        ],
        ctaTitle: 'Prêt à construire ?',
        ctaText: 'Ajoutez FormKrafter à l’app que vous avez déjà.',
        ctaStar: 'Star sur GitHub',
        footTag: 'Web Components propulsés par Stencil sur le web, primitives natives sur mobile.',
      }
    : {
        navDocs: 'Docs',
        navDemo: 'Demo',
        navStart: 'Get started',
        pill: 'MIT · Web Components · React · Vue · React Native',
        h1a: 'Build forms once,',
        h1b: 'run them everywhere',
        lede: 'A drag & drop form builder and renderer that works in plain HTML, React, Vue or React Native — with validation, dynamic rules, nested forms and i18n built in.',
        ctaStart: 'Get started →',
        ctaDemo: 'Try the live demo',
        install: 'bun add @streamline-pulse/formkrafter-react',
        howEyebrow: 'How it works',
        howTitle: 'One JSON spec. Three steps. Zero drift.',
        steps: [
          {
            n: '01',
            title: 'Describe',
            text: 'Every form is a JSON tree of bricks — fields, panels, validations, rules. Exportable, diffable, storable anywhere.',
            code: `{ id: 'email', validations: [required] }`,
          },
          {
            n: '02',
            title: 'Validate',
            text: 'The same spec compiles to an Ajv schema — client-side in real time, server-side with the exact same verdict.',
            code: `validateFormData(spec, data, 'fr')`,
          },
          {
            n: '03',
            title: 'Render',
            text: 'One spec, four renderers: plain Web Components, React, Vue or React Native — pick per app, keep one source of truth.',
            code: `<FkFormRender spec={spec} />`,
          },
        ],
        fwEyebrow: 'Integrations',
        fwTitle: 'One behavior, three ways to wire it in.',
        frameworks: [
          {
            name: 'Web Components',
            text: 'Pure custom elements (Stencil). No framework dependency.',
            install: 'bun add @streamline-pulse/formkrafter-wc',
          },
          {
            name: 'React',
            text: 'Thin wrappers generated from the web components — typed props and events.',
            install: 'bun add @streamline-pulse/formkrafter-react',
          },
          {
            name: 'Vue 3',
            text: 'Same surface, native Vue components.',
            install: 'bun add @streamline-pulse/formkrafter-vue',
          },
        ],
        whyEyebrow: 'Why',
        whyTitle: 'Why FormKrafter.',
        features: [
          {
            icon: '🧩',
            title: 'Framework-agnostic',
            text: 'Web Components at the core; React and Vue wrappers generated from the same source.',
          },
          {
            icon: '⚡',
            title: 'Actually lightweight',
            text: '~130 KB gzipped for a page running the full builder. Lazy-loaded code editor, zero CSS framework.',
          },
          {
            icon: '🛡️',
            title: 'Rules without eval',
            text: 'JSON Logic or JS sandboxed by an AST interpreter: CSP-safe, execution budget.',
          },
          {
            icon: '📄',
            title: 'Specs, not components',
            text: 'Forms as portable JSON. RFC 6902 patches both ways, built-in undo/redo.',
          },
          {
            icon: '🔁',
            title: 'Form.io converter',
            text: 'convertFormioForm migrates fields, wizards, validations and uploads — reports the rest.',
          },
          {
            icon: '🌍',
            title: 'i18n end to end',
            text: 'Content and builder chrome localized; English and French shipped, extendable.',
          },
        ],
        codeEyebrow: 'In practice',
        codeTitle: 'One builder, one renderer, one event.',
        codeFile: 'App.tsx',
        migEyebrow: 'Migration',
        migTitle: 'Coming from Form.io?',
        migText: 'Cut your gzipped form-stack weight by ~3.5×, drop Bootstrap, and watch stored definitions shrink 3–5.5× on real production exports.',
        migCta: 'Migration guide',
        migFig1: '470 KB → 130 KB',
        migFig2: 'specs ÷ 3–5,5',
        usesEyebrow: 'Use cases',
        usesTitle: 'Where it actually earns its keep.',
        uses: [
          {
            title: 'Internal tools & back office',
            text: 'Case management, approvals, admin consoles — the forms your ops team touches every day.',
          },
          {
            title: 'Citizen services',
            text: 'Multi-language public forms, official documents, conditional eligibility rules.',
          },
          {
            title: 'Onboarding & surveys',
            text: 'KYC flows, product onboarding, feedback — wizards with per-step validation.',
          },
          {
            title: 'Embeddable builder',
            text: 'Give your own customers a form builder — white-label the palette, keep your data model.',
          },
        ],
        ctaTitle: 'Ready to build?',
        ctaText: 'Add FormKrafter to the app you already have.',
        ctaStar: 'Star on GitHub',
        footTag: 'Stencil-powered Web Components on the web, native primitives on mobile.',
      }
---

<div class="fk">
  <header class="fk-nav">
    <a class="fk-brand" href={base}>FormKrafter</a>
    <nav class="fk-nav-links">
      <a href={`${base}getting-started/`}>{t.navDocs}</a>
      <a href={`${base}demo/`}>{t.navDemo}</a>
      <a href={github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="fk-lang" href={altHref}>{lang === 'fr' ? 'EN' : 'FR'}</a>
      <button
        type="button"
        class="fk-theme-toggle"
        id="fkThemeToggle"
        aria-label="Toggle color theme"
      >
        <span class="fk-theme-toggle__sun" aria-hidden="true">☀</span>
        <span class="fk-theme-toggle__moon" aria-hidden="true">☾</span>
      </button>
      <a class="fk-btn fk-btn--primary fk-btn--sm" href={`${base}getting-started/`}
        >{t.navStart}</a
      >
    </nav>
  </header>

  <!-- HERO -->
  <main class="fk-hero">
    <div class="fk-hero-copy">
      <span class="fk-pill">{t.pill}</span>
      <h1 class="fk-title">{t.h1a}<br /><span class="fk-grad">{t.h1b}</span></h1>
      <p class="fk-lede">{t.lede}</p>
      <div class="fk-cta">
        <a class="fk-btn fk-btn--primary" href={`${base}getting-started/`}>{t.ctaStart}</a>
        <a class="fk-btn fk-btn--ghost" href={`${base}demo/`}>{t.ctaDemo}</a>
      </div>
      <p class="fk-install"><code><span class="fk-dollar">$</span> {t.install}</code></p>
    </div>

    <!-- Drag-to-build mock -->
    <div class="fk-visual" aria-hidden="true">
      <div class="fk-builder">
        <div class="fk-palette">
          <div class="fk-mini-head">Palette</div>
          <button class="fk-chip" data-chip="0">Text</button>
          <button class="fk-chip" data-chip="1">Email</button>
          <button class="fk-chip" data-chip="2">Select</button>
          <button class="fk-chip" data-chip="3">Checkbox</button>
        </div>
        <div class="fk-canvas">
          <div class="fk-mini-head">Canvas</div>
          <div class="fk-canvas-body" id="fkCanvasBody"></div>
          <div class="fk-drop-hint" id="fkDropHint">Drop a brick here</div>
        </div>
        <div class="fk-ghost" id="fkGhost"></div>
      </div>
      <div class="fk-visual-bar">
        <span class="fk-status"><span class="fk-status-dot"></span> spec.json → live form</span>
      </div>
    </div>
  </main>

  <!-- HOW IT WORKS -->
  <section class="fk-section" id="how">
    <div class="fk-section-head">
      <span class="fk-eyebrow">{t.howEyebrow}</span>
      <h2>{t.howTitle}</h2>
    </div>
    <ol class="fk-steps">
      {
        t.steps.map((s) => (
          <li>
            <span class="fk-step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <pre class="fk-mini-code"><code>{s.code}</code></pre>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- FRAMEWORK SUPPORT -->
  <section class="fk-section">
    <div class="fk-section-head">
      <span class="fk-eyebrow">{t.fwEyebrow}</span>
      <h2>{t.fwTitle}</h2>
    </div>
    <div class="fk-frameworks">
      {
        t.frameworks.map((f) => (
          <article class="fk-fw-card">
            <h3>{f.name}</h3>
            <p>{f.text}</p>
            <code class="fk-fw-install">{f.install}</code>
          </article>
        ))
      }
    </div>
  </section>

  <!-- FEATURES -->
  <section class="fk-section">
    <div class="fk-section-head">
      <span class="fk-eyebrow">{t.whyEyebrow}</span>
      <h2>{t.whyTitle}</h2>
    </div>
    <div class="fk-features">
      {
        t.features.map((f) => (
          <article class="fk-card">
            <div class="fk-card-ic">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CODE EXAMPLE -->
  <section class="fk-section">
    <div class="fk-section-head">
      <span class="fk-eyebrow">{t.codeEyebrow}</span>
      <h2>{t.codeTitle}</h2>
    </div>
    <div class="fk-code-card">
      <div class="fk-code-top">
        <span class="fk-dotc"></span><span class="fk-dotc"></span><span class="fk-dotc"
        ></span>
        <span class="fk-code-file">{t.codeFile}</span>
      </div>
      <pre><code><span class="fk-k">import</span> {'{'} useState {'}'} <span class="fk-k">from</span> <span class="fk-s">'react'</span>
<span class="fk-k">import</span> {'{'} FkFormBuilder, FkFormRender {'}'} <span class="fk-k">from</span> <span class="fk-s">'@streamline-pulse/formkrafter-react'</span>
<span class="fk-k">import</span> <span class="fk-s">'@streamline-pulse/formkrafter-wc/styles.css'</span>

<span class="fk-k">export function</span> <span class="fk-fn">FormStudio</span>() {'{'}
  <span class="fk-k">const</span> [spec, setSpec] = <span class="fk-fn">useState</span>()

  <span class="fk-k">return</span> (
    {'<>'}
      {'<FkFormBuilder'} <span class="fk-attr">onSpecChange</span>={'{(e)'} {'=>'} <span class="fk-fn">setSpec</span>(e.detail.spec){'} />'}
      {'{spec && ('}
        {'<FkFormRender'}
          <span class="fk-attr">spec</span>={'{spec}'}
          <span class="fk-attr">onFormSubmit</span>={'{(e)'} {'=>'} console.<span class="fk-fn">log</span>(e.detail.data){'}'}
        {'/>'}
      {')}'}
    {'</>'}
  )
{'}'}</code></pre>
    </div>
  </section>

  <!-- MIGRATION -->
  <section class="fk-mig">
    <div class="fk-mig-body">
      <span class="fk-eyebrow">{t.migEyebrow}</span>
      <h2>{t.migTitle}</h2>
      <p>{t.migText}</p>
    </div>
    <div class="fk-mig-side">
      <div class="fk-mig-figures">
        <span class="fk-mig-figure">{t.migFig1}</span>
        <span class="fk-mig-figure">{t.migFig2}</span>
      </div>
      <a class="fk-btn fk-btn--ghost" href={`${base}guides/formio-migration/`}>{t.migCta} →</a>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="fk-section">
    <div class="fk-section-head">
      <span class="fk-eyebrow">{t.usesEyebrow}</span>
      <h2>{t.usesTitle}</h2>
    </div>
    <div class="fk-uses">
      {
        t.uses.map((u) => (
          <div class="fk-use">
            <h3>{u.title}</h3>
            <p>{u.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="fk-cta-band">
    <h2>{t.ctaTitle}</h2>
    <p>{t.ctaText}</p>
    <div class="fk-cta">
      <a class="fk-btn fk-btn--primary" href={`${base}getting-started/`}>{t.ctaStart}</a>
      <a class="fk-btn fk-btn--ghost" href={github} target="_blank" rel="noreferrer"
        >{t.ctaStar}</a
      >
    </div>
    <p class="fk-install"><code><span class="fk-dollar">$</span> {t.install}</code></p>
  </section>

  <footer class="fk-foot">
    <span
      >MIT © <a href="https://streamline-pulse.com" target="_blank" rel="noreferrer"
        >Streamline Pulse</a
      > — {t.footTag}</span
    >
    <span class="fk-foot-links">
      <a href={`${base}getting-started/`}>{t.navDocs}</a>
      <a href={github} target="_blank" rel="noreferrer">GitHub</a>
    </span>
  </footer>
</div>

<style is:global>
  :root {
    --fk-bg: #081314;
    --fk-bg-soft: #0d1b1d;
    --fk-ink: #eaf4f3;
    --fk-muted: #93a8a7;
    --fk-line: rgba(120, 190, 185, 0.16);
    --fk-line-soft: rgba(120, 190, 185, 0.08);
    --fk-accent: #4fb8b2;
    --fk-accent-strong: color-mix(in srgb, var(--fk-accent) 55%, white);
    --fk-accent-ink: #04211f;
    --fk-danger: #ff9d7a;
    --fk-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  :root[data-theme='light'] {
    --fk-bg: #fbfdfc;
    --fk-bg-soft: #f2f7f6;
    --fk-ink: #0e2a29;
    --fk-muted: #4c6866;
    --fk-line: rgba(29, 90, 96, 0.14);
    --fk-line-soft: rgba(29, 90, 96, 0.07);
    --fk-accent: #1d5a60;
    --fk-accent-strong: color-mix(in srgb, var(--fk-accent) 80%, black);
    --fk-accent-ink: #ffffff;
    --fk-danger: #d9603f;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background:
      radial-gradient(60rem 40rem at 82% -8%, color-mix(in srgb, var(--fk-accent) 10%, transparent), transparent 58%),
      radial-gradient(48rem 34rem at 6% 2%, color-mix(in srgb, var(--fk-accent) 8%, transparent), transparent 55%),
      var(--fk-bg);
    color: var(--fk-ink);
    font-family:
      ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }

  body * {
    box-sizing: border-box;
  }

  body a {
    color: inherit;
    text-decoration: none;
  }
</style>

<style>
  .fk {
    max-width: 74rem;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  /* ---- nav ---- */
  .fk-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
  }

  .fk-brand {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .fk-nav-links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .fk-nav-links > a:not(.fk-btn) {
    color: var(--fk-muted);
    font-size: 0.92rem;
    transition: color 0.15s;
  }

  .fk-nav-links > a:not(.fk-btn):hover {
    color: var(--fk-ink);
  }

  .fk-lang {
    border: 1px solid var(--fk-line);
    border-radius: 999px;
    padding: 0.24rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .fk-theme-toggle {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    border: 1px solid var(--fk-line);
    background: none;
    color: var(--fk-muted);
    cursor: pointer;
    font-size: 0.95rem;
  }

  .fk-theme-toggle__moon {
    display: none;
  }

  :global(:root[data-theme='light']) .fk-theme-toggle__sun {
    display: none;
  }

  :global(:root[data-theme='light']) .fk-theme-toggle__moon {
    display: inline;
  }

  /* ---- buttons ---- */
  .fk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-weight: 600;
    padding: 0.8rem 1.4rem;
    font-size: 0.98rem;
    transition:
      transform 0.12s,
      background 0.15s,
      border-color 0.15s,
      opacity 0.15s;
    white-space: nowrap;
  }

  .fk-btn:active {
    transform: translateY(1px);
  }

  .fk-btn--sm {
    padding: 0.5rem 0.95rem;
    font-size: 0.88rem;
  }

  .fk-btn--primary {
    background: linear-gradient(120deg, var(--fk-accent), var(--fk-accent-strong));
    color: var(--fk-accent-ink);
  }

  .fk-btn--primary:hover {
    opacity: 0.88;
  }

  .fk-btn--ghost {
    border: 1px solid var(--fk-line);
    background: color-mix(in srgb, var(--fk-ink) 3%, transparent);
  }

  .fk-btn--ghost:hover {
    border-color: color-mix(in srgb, var(--fk-accent) 50%, transparent);
  }

  /* ---- hero ---- */
  .fk-hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 4vh 0 4rem;
  }

  .fk-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--fk-line);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--fk-muted);
    background: color-mix(in srgb, var(--fk-ink) 3%, transparent);
  }

  .fk-title {
